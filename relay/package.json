{
  "name": "@runmeter/local-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "runmeter-relay": "./runmeter-relay.mjs"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-transform-types server.ts",
    "dev": "node --env-file-if-exists=.env --experimental-transform-types --watch server.ts",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
