{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "electron"],
    "verbatimModuleSyntax": true
  },
  "include": ["main.ts", "bridge.ts", "types.d.ts", "../relay/**/*.ts"],
  "exclude": ["../relay/tests", "../relay/tests/fixtures"]
}
