{
  "name": "runmeter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Codex・Claudeの利用率、リセット日時、トークン履歴を端末内で確認するWeb／Windows向けダッシュボード。AI認証情報・利用データのクラウド保存なし。",
  "type": "module",
  "author": {
    "name": "サイバーアイ・テクノロジー株式会社",
    "url": "https://cybereye-tech.jp/"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "relay": "npm --prefix relay start",
    "relay:dev": "npm --prefix relay run dev",
    "relay:typecheck": "tsc --noEmit -p relay/tsconfig.json",
    "desktop:setup": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop run start",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:make": "npm --prefix desktop run make",
    "test": "npm run test:relay",
    "test:relay": "npm --prefix relay test",
    "test:web": "playwright test",
    "check:public": "node scripts/check-public-data.mjs",
    "test:public": "node --test tests/public-release.test.mjs tests/license-notices.test.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs && node scripts/prepare-public-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check && node scripts/prepare-public-licenses.mjs --check",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.4.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.18.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
